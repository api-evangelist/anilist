                  "item": [
                    {
                      "name": "Begin the OAuth2 authorization flow",
                      "id": "fb9619f9-0839-43cc-b7d2-9712879ce622",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                          "raw": "https://anilist.co/api/v2/oauth/authorize?client_id=<string>&redirect_uri=<uri>&response_type=token&state=<string>",
                          "protocol": "https",
                          "host": [
                            "anilist",
                            "co"
                          ],
                          "path": [
                            "api",
                            "v2",
                            "oauth",
                            "authorize"
                          ],
                          "query": [
                            {
                              "description": "(Required) The client ID of the developer application",
                              "key": "client_id",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) Registered redirect URI for the application",
                              "key": "redirect_uri",
                              "value": "<uri>"
                            },
                            {
                              "description": "(Required) `code` for Authorization Code Grant, `token` for Implicit Grant",
                              "key": "response_type",
                              "value": "token"
                            },
                            {
                              "description": "Opaque value the client can use to maintain state between request and callback",
                              "key": "state",
                              "value": "<string>"
                            }
                          ]
                        },
                        "description": "Redirect a user to this endpoint to begin the OAuth2 Authorization Code or Implicit grant flow. The redirect URI must exactly match the URI configured on the developer application."
                      },
                      "response": [
                        {
                          "id": "58500a03-99fe-4e60-8807-1e8c7a624ab3",
                          "name": "Redirects to the configured redirect_uri with `code` (Authorization Code) or `#access_token` fragment (Implicit)",
