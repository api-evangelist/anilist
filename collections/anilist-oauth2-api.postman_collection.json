          "id": "c001c03b-0109-448e-8c03-67b59eb7b06d",
          "name": "Display the OAuth2 auth pin for manual entry",
          "request": {
            "name": "Display the OAuth2 auth pin for manual entry",
            "description": {
              "content": "Auth Pin redirect that displays an access token on a page for the user to copy and paste into a client application. Useful for clients that cannot register an HTTP or custom URI scheme redirect. Supports both Authorization Code and Implicit flows.",
