          "name": "Begin the OAuth2 authorization flow",
          "request": {
            "name": "Begin the OAuth2 authorization flow",
            "description": {
              "content": "Redirect a user to this endpoint to begin the OAuth2 Authorization Code or Implicit grant flow. The redirect URI must exactly match the URI configured on the developer application.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "v2",
                "oauth",
                "authorize"
              ],
              "host": [
                "anilist",
                "co"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client ID of the developer application"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Registered redirect URI for the application"
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) `code` for Authorization Code Grant, `token` for Implicit Grant"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Opaque value the client can use to maintain state between request and callback"
